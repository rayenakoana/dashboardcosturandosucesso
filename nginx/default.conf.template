server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # ── Claude proxy → Supabase Edge Function ───────────────────────────────
    # Nginx é um proxy fino: não injeta segredos nem valida JWTs.
    # Autenticação e forwarding para a Anthropic são responsabilidade da Edge
    # Function claude-proxy (Supabase), que verifica o JWT do usuário.
    location /api/claude {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin  * always;
            add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, Authorization" always;
            return 204;
        }

        limit_except POST OPTIONS { deny all; }

        proxy_pass              ${SUPABASE_FUNCTIONS_URL}/claude-proxy;
        proxy_ssl_server_name   on;
        proxy_set_header Host              $proxy_host;
        proxy_set_header Authorization     $http_authorization;
        proxy_set_header Content-Type      "application/json";

        add_header Access-Control-Allow-Origin  * always;
        add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization" always;
    }

    # ── Admin proxy → Supabase Edge Function ────────────────────────────────
    # Nginx é um proxy fino: não injeta segredos nem verifica role.
    # Autenticação JWT e verificação de role admin são responsabilidade da Edge
    # Function admin-criar-usuario (Supabase).
    location /api/admin/criar-usuario {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin  * always;
            add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, Authorization" always;
            return 204;
        }

        limit_except POST OPTIONS { deny all; }

        proxy_pass              ${SUPABASE_FUNCTIONS_URL}/admin-criar-usuario;
        proxy_ssl_server_name   on;
        proxy_set_header Host           $proxy_host;
        proxy_set_header Authorization  $http_authorization;
        proxy_set_header Content-Type   "application/json";

        add_header Access-Control-Allow-Origin  * always;
        add_header Access-Control-Allow-Methods "POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization" always;
    }

    # ── SPA fallback ─────────────────────────────────────────────────────────
    location / {
        try_files $uri $uri/ /index.html;
    }
}
