# Supabase (expostos ao browser — prefixo VITE_ obrigatório)
VITE_SUPABASE_URL="https://<project-id>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-key>"
VITE_SUPABASE_PROJECT_ID="<project-id>"

# Supabase (sem prefixo VITE_ — usados apenas server-side em alguns contextos)
SUPABASE_URL="https://<project-id>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<anon-key>"

# ── URL das Supabase Edge Functions ──────────────────────────────────────────
# Nginx proxy (produção) e Vite proxy (desenvolvimento local) encaminham
# /api/claude → ${SUPABASE_FUNCTIONS_URL}/claude-proxy
# /api/admin/criar-usuario → ${SUPABASE_FUNCTIONS_URL}/admin-criar-usuario
#
# Formato: https://<project-id>.supabase.co/functions/v1
#
# Produção (VPS):
#   docker run -e SUPABASE_FUNCTIONS_URL=https://<id>.supabase.co/functions/v1 \
#     -p 80:80 cs-dash:latest
#
# Desenvolvimento local: adicione ao .env.local (não versionado):
#   SUPABASE_FUNCTIONS_URL=https://<id>.supabase.co/functions/v1
SUPABASE_FUNCTIONS_URL="https://<project-id>.supabase.co/functions/v1"

# ── Segredos das Edge Functions (Supabase secrets — NUNCA no Docker) ─────────
# Configurar via: supabase secrets set NOME=valor
# Nunca colocar estes valores no .env, no Dockerfile ou em variáveis de container.
#
#   supabase secrets set ANTHROPIC_KEY=sk-ant-...
#   supabase secrets set N8N_ADMIN_URL=https://n8n.costurandosucesso.com/webhook/admin-criar-usuario
#   supabase secrets set N8N_ADMIN_SECRET=<secret>
#
# ANTHROPIC_KEY    → usado pela Edge Function claude-proxy
# N8N_ADMIN_URL    → usado pela Edge Function admin-criar-usuario
# N8N_ADMIN_SECRET → usado pela Edge Function admin-criar-usuario
