# Supabase (expostos ao browser — prefixo VITE_ obrigatório)
VITE_SUPABASE_URL="https://<project-id>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-key>"
VITE_SUPABASE_PROJECT_ID="<project-id>"

# Supabase (sem prefixo VITE_ — usados apenas server-side em alguns contextos)
SUPABASE_URL="https://<project-id>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<anon-key>"

# N8N — server-side ONLY (sem prefixo VITE_ para não expor no bundle do browser)
# Usados pelo proxy Nginx (produção) e pelo proxy Vite (desenvolvimento local)
N8N_ADMIN_CRIAR_USUARIO_URL="https://n8n.costurandosucesso.com/webhook/admin-criar-usuario"
N8N_ADMIN_SECRET="<secret-aqui>"

# Docker build args (passados na hora do build, não ficam no bundle)
# docker build --build-arg ANTHROPIC_KEY=... --build-arg N8N_ADMIN_SECRET=... --build-arg N8N_ADMIN_URL=...
# ANTHROPIC_KEY=<anthropic-api-key>
